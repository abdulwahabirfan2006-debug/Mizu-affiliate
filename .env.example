# App ka public address. Live hone par https zaroori hai.
APP_URL=http://localhost:3000
PORT=3000

# Pehli dafa chalane par admin account in se banta hai (password kam az kam 10 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Shopify store (sirf myshopify domain, https ke baghair)
SHOPIFY_STORE=your-store.myshopify.com

# Tareeqa A (recommended): Dev Dashboard app ka Client ID aur Secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Purani admin custom app ka token (agar pehle se bana hua hai)
SHOPIFY_ACCESS_TOKEN=

# Tareeqa B: sirf order tracking. Shopify admin > Settings > Notifications > Webhooks wali signing key
SHOPIFY_WEBHOOK_SECRET=

# Agar app reverse proxy ke peeche hai (Render, Railway, nginx) to 1
TRUST_PROXY=0

# Database file
DB_PATH=./data/app.db
